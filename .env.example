# Cloudinary — upload de imagens (banners e produtos)
# 1. Crie conta gratis em cloudinary.com
# 2. Dashboard → Settings → Upload → Upload Presets → Add preset → Mode: Unsigned → Save
# 3. Copie o Cloud Name do topo do dashboard
VITE_CLOUDINARY_CLOUD_NAME="seu_cloud_name_aqui"
VITE_CLOUDINARY_UPLOAD_PRESET="seu_preset_aqui"
